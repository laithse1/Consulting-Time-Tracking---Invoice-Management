# All VITE_* values are public and embedded in the frontend build. Never put keys here.
VITE_APP_TITLE=Consulting Invoice Manager
VITE_WORKSPACE_LABEL=Independent consulting
# Leave empty for the local, same-origin packaged application.
VITE_API_BASE_URL=
VITE_BASE_PATH=/
VITE_DEV_API_TARGET=http://127.0.0.1:8080
VITE_ASSISTANT_AUTOSAVE_MS=600
VITE_TIMER_TICK_MS=1000
VITE_NOTICE_DURATION_MS=5000
