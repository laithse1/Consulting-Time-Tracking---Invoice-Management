# Docker Compose runtime settings. Native Java requires exported environment variables.
# Required: private workspace access token of at least 24 characters (not an AI API key).
APP_TOKEN=
APP_PORT=8080
# Host-side persistent directory used by Docker Compose.
DATA_DIR=./data
# Exact frontend origins for a split deployment; leave empty for local use.
APP_ALLOWED_ORIGINS=
INVOICE_NUMBER_PREFIX=LA
# Assistant input, history, and saved correction limits.
ASSISTANT_MAX_SOURCE_CHARACTERS=10000
ASSISTANT_MAX_ACTIONS=30
ASSISTANT_HISTORY_LIMIT=50
ASSISTANT_MAX_REVISIONS=30
# Optional AI request limits. Provider models/endpoints/credentials live in config/assistant-providers.json.
AI_CONNECT_TIMEOUT=8s
AI_REQUEST_TIMEOUT=35s
AI_RESPONSE_TIMEOUT=20s
AI_MAX_RESPONSE_BYTES=1048576
AI_MAX_CONFIG_BYTES=262144
LOG_LEVEL=INFO
# Swagger UI: /swagger-ui/index.html; JSON: /v3/api-docs; YAML: /v3/api-docs.yaml.
# Full URL/authentication reference: docs/api.md.
API_DOCS_ENABLED=true
